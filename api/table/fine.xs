// Stores fines generated by overdue book returns.
table fine {
  auth = false

  schema {
    int id
    timestamp created_at?=now {
      visibility = "private"
    }

    int loan_id {
      table = "loan"
    }
    int reader_id {
      table = "reader"
    }
    int overdue_days?=0
    int amount_cents?=0
    timestamp generated_at?=now
    enum status {
      values = ["Pendente", "Paga", "Abonada", "Zerada"]
    }
    int resolved_by?
    timestamp resolved_at?
    text resolution_notes?
  }

  index = [
    {type: "primary", field: [{name: "id"}]}
    {type: "btree|unique", field: [{name: "loan_id", op: "asc"}]}
    {type: "btree", field: [{name: "reader_id", op: "asc"}]}
    {type: "btree", field: [{name: "status", op: "asc"}]}
    {type: "btree", field: [{name: "generated_at", op: "desc"}]}
  ]

  tags = ["biblioteca"]
  guid = "fine-balcao-2026"
}
